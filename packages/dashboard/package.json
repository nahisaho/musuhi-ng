{
  "name": "@musuhi-ng/dashboard",
  "version": "1.0.2",
  "description": "TUI Dashboard for MUSUHI 2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "musuhi-dashboard": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": [
    "musuhi",
    "dashboard",
    "tui"
  ],
  "author": "MUSUHI Contributors",
  "license": "MIT",
  "dependencies": {
    "@musuhi-ng/core": "^1.0.0",
    "blessed": "^0.1.81",
    "blessed-contrib": "^4.11.0"
  },
  "devDependencies": {
    "@types/blessed": "^0.1.25",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/musuhi/musuhi2.git",
    "directory": "packages/dashboard"
  },
  "bugs": {
    "url": "https://github.com/musuhi/musuhi2/issues"
  },
  "homepage": "https://musuhi.github.io/musuhi2"
}
