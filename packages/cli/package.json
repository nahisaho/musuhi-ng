{
  "name": "@musuhi/cli",
  "version": "0.1.0",
  "description": "Command-line interface for MUSUHI 2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "bin": {
    "musuhi": "./dist/cli.js"
  },
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc --build",
    "dev": "tsc --build --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "lint": "eslint src --ext .ts",
    "lint:fix": "eslint src --ext .ts --fix",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist *.tsbuildinfo"
  },
  "keywords": [
    "musuhi",
    "sdd",
    "cli"
  ],
  "author": "MUSUHI Contributors",
  "license": "MIT",
  "dependencies": {
    "@musuhi/constitutional-governance": "workspace:*",
    "@musuhi/core": "workspace:*",
    "chalk": "^5.3.0",
    "commander": "^12.0.0",
    "inquirer": "^9.2.0",
    "ora": "^8.0.0"
  },
  "devDependencies": {
    "@types/inquirer": "^9.0.7",
    "@types/node": "^20.11.0",
    "typescript": "^5.3.3",
    "vitest": "^1.6.1"
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/musuhi/musuhi2.git",
    "directory": "packages/cli"
  },
  "bugs": {
    "url": "https://github.com/musuhi/musuhi2/issues"
  },
  "homepage": "https://musuhi.github.io/musuhi2"
}
