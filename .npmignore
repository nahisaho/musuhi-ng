# MUSUHI 2.0 - npm Ignore Configuration
# Files to exclude from npm packages

# Development files
*.test.ts
*.spec.ts
**/__tests__/
**/__mocks__/
*.tsbuildinfo
tsconfig.json
tsconfig.*.json

# Source files (publish only dist)
src/

# Documentation (except README)
docs/
*.md
!README.md
!LICENSE
!CHANGELOG.md

# Configuration files
.eslintrc.*
.prettierrc.*
.editorconfig
.gitignore
.npmignore
vitest.config.*

# Build artifacts
coverage/
.nyc_output/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db

# Git
.git/
.gitattributes
.github/

# CI/CD
.circleci/
.travis.yml
.gitlab-ci.yml
azure-pipelines.yml

# Misc
*.orig
.husky/
