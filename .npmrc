# MUSUHI 2.0 npm Configuration

# Public registry
registry=https://registry.npmjs.org/

# Scoped packages - publish to public registry
@musuhi:registry=https://registry.npmjs.org/

# Access level for scoped packages
access=public

# Save exact versions
save-exact=true

# Engine strict mode
engine-strict=true

# Peer dependencies
auto-install-peers=true
strict-peer-dependencies=false
